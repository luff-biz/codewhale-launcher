msgstr "Hoje: %s · 7 dias: %s"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Codewhale: choose a project directory"
msgstr "Codewhale: escolha um diretório de projeto"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Launch failed: %s"
msgstr "Falha ao iniciar: %s"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Full history…"
msgstr "Histórico completo…"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Codewhale Sessions"
msgstr "Sessões do Codewhale"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Search sessions…"
msgstr "Pesquisar sessões…"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Show hidden sessions"
msgstr "Mostrar sessões ocultas"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "No sessions found"
msgstr "Nenhuma sessão encontrada"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Restore"
msgstr "Restaurar"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Remove “%s”?"
msgstr "Remover “%s”?"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "The session disappears from the launcher list but stays in the Codewhale store."
msgstr "A sessão desaparece da lista do launcher, mas permanece no armazenamento do Codewhale."

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Also delete the session permanently from the Codewhale store"
msgstr "Eliminar também a sessão permanentemente do armazenamento do Codewhale"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "This cannot be undone: the session can no longer be resumed and its costs vanish from the launcher statistics."
msgstr "Isto não pode ser anulado: a sessão deixa de poder ser retomada e os seus custos desaparecem das estatísticas do launcher."

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Cancel"
msgstr "Cancelar"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Remove"
msgstr "Remover"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Could not delete: %s"
msgstr "Não foi possível eliminar: %s"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Dashboard"
msgstr "Painel"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Refresh"
msgstr "Atualizar"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Settings"
msgstr "Configurações"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Generating…"
msgstr "Gerando…"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "No session selected"
msgstr "Nenhuma sessão selecionada"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "The session no longer exists"
msgstr "A sessão não existe mais"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Dashboard failed: %s"
msgstr "Falha no painel: %s"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "(empty)"
msgstr "(vazio)"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "stale"
msgstr "desatualizado"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Updated: %s"
msgstr "Atualizado: %s"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Dashboard settings"
msgstr "Configurações do painel"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Status prompt"
msgstr "Prompt de status"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Maximum cache age (minutes)"
msgstr "Idade máxima do cache (minutos)"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Save"
msgstr "Salvar"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Maximum cache age"
msgstr "Idade máxima do cache"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Minutes before the status is regenerated even if the workspace has not changed."
msgstr "Minutos antes de o estado ser regenerado mesmo que o espaço de trabalho não tenha mudado."

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "A compact “current status” of a session’s workspace, generated with codewhale and cached to save tokens. Open it from the dashboard button next to each session."
msgstr "Um “estado atual” compacto do espaço de trabalho de uma sessão, gerado com o codewhale e colocado em cache para poupar tokens. Abra-o pelo botão do painel junto de cada sessão."

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Sent to `codewhale exec`. Kept generic — the workspace’s own instructions define what “status” means."
msgstr "Enviado para `codewhale exec`. Mantido genérico — as instruções do próprio espaço de trabalho definem o que «estado» significa."
