msgstr "Bijgewerkt: %s"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Dashboard settings"
msgstr "Dashboardinstellingen"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Status prompt"
msgstr "Statusprompt"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Maximum cache age (minutes)"
msgstr "Maximale cacheleeftijd (minuten)"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Save"
msgstr "Opslaan"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Maximum cache age"
msgstr "Maximale cacheleeftijd"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Minutes before the status is regenerated even if the workspace has not changed."
msgstr "Minuten voordat de status opnieuw wordt gegenereerd, ook als de werkruimte niet is veranderd."

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "A compact “current status” of a session’s workspace, generated with codewhale and cached to save tokens. Open it from the dashboard button next to each session."
msgstr "Een compacte “huidige status” van de werkruimte van een sessie, gegenereerd met codewhale en gecachet om tokens te besparen. Open het via de dashboardknop naast elke sessie."

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Sent to `codewhale exec`. Kept generic — the workspace’s own instructions define what “status” means."
msgstr "Wordt naar `codewhale exec` gestuurd. Bewust generiek gehouden: de eigen instructies van de werkruimte bepalen wat “status” betekent."

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "About Codewhale Launcher"
msgstr "Over Codewhale Launcher"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Main Menu"
msgstr "Hoofdmenu"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Start and resume Codewhale sessions straight from the top bar — one-click new sessions, recent sessions, balance and costs, and a per-session dashboard. No terminal required."
msgstr "Start en hervat Codewhale-sessies rechtstreeks vanuit de bovenbalk: nieuwe sessies met één klik, recente sessies, saldo en kosten, en een dashboard per sessie. Geen terminal nodig."

