#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "just now"
msgstr "ahora mismo"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "%d s ago"
msgstr "hace %d s"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "%d min ago"
msgstr "hace %d min"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "%d h ago"
msgstr "hace %d h"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "%d d ago"
msgstr "hace %d d"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "New session…"
msgstr "Nueva sesión…"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Recent sessions"
msgstr "Sesiones recientes"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "No saved sessions"
msgstr "No hay sesiones guardadas"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Balance: %s"
msgstr "Saldo: %s"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "No balance lookup for “%s”"
msgstr "Sin consulta de saldo para «%s»"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Balance unavailable (%s)"
msgstr "Saldo no disponible (%s)"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Today: %s · 7 days: %s"
msgstr "Hoy: %s · 7 días: %s"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Codewhale: choose a project directory"
msgstr "Codewhale: elige un directorio de proyecto"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Launch failed: %s"
msgstr "Error al iniciar: %s"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Full history…"
msgstr "Historial completo…"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Codewhale Sessions"
msgstr "Sesiones de Codewhale"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Search sessions…"
msgstr "Buscar sesiones…"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Show hidden sessions"
msgstr "Mostrar sesiones ocultas"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "No sessions found"
msgstr "No se encontraron sesiones"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Restore"
msgstr "Restaurar"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Remove “%s”?"
msgstr "¿Quitar «%s»?"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "The session disappears from the launcher list but stays in the Codewhale store."
msgstr "La sesión desaparece de la lista del lanzador, pero permanece en el almacén de Codewhale."

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Also delete the session permanently from the Codewhale store"
msgstr "Eliminar también la sesión de forma permanente del almacén de Codewhale"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "This cannot be undone: the session can no longer be resumed and its costs vanish from the launcher statistics."
msgstr "Esto no se puede deshacer: la sesión ya no podrá reanudarse y sus costes desaparecerán de las estadísticas del lanzador."

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Cancel"
msgstr "Cancelar"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Remove"
msgstr "Quitar"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Could not delete: %s"
msgstr "No se pudo eliminar: %s"
