#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "just now"
msgstr "gerade eben"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "%d s ago"
msgstr "vor %d Sek."

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "%d min ago"
msgstr "vor %d Min."

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "%d h ago"
msgstr "vor %d Std."

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "%d d ago"
msgstr "vor %d Tagen"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "New session…"
msgstr "Neue Session …"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Recent sessions"
msgstr "Letzte Sessions"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "No saved sessions"
msgstr "Keine gespeicherten Sessions"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Balance: %s"
msgstr "Guthaben: %s"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "No balance lookup for “%s”"
msgstr "Kein Guthaben-Abruf für „%s“"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Balance unavailable (%s)"
msgstr "Guthaben nicht verfügbar (%s)"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Today: %s · 7 days: %s"
msgstr "Heute: %s · 7 Tage: %s"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Codewhale: choose a project directory"
msgstr "Codewhale: Projektverzeichnis wählen"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Launch failed: %s"
msgstr "Start fehlgeschlagen: %s"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Full history…"
msgstr "Vollständige Historie …"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Codewhale Sessions"
msgstr "Codewhale-Sessions"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Search sessions…"
msgstr "Sessions durchsuchen …"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Show hidden sessions"
msgstr "Ausgeblendete Sessions anzeigen"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "No sessions found"
msgstr "Keine Sessions gefunden"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Restore"
msgstr "Wiederherstellen"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Remove “%s”?"
msgstr "„%s“ entfernen?"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "The session disappears from the launcher list but stays in the Codewhale store."
msgstr "Die Session verschwindet aus der Launcher-Liste, bleibt aber im Codewhale-Store erhalten."

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Also delete the session permanently from the Codewhale store"
msgstr "Session zusätzlich endgültig aus dem Codewhale-Store löschen"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "This cannot be undone: the session can no longer be resumed and its costs vanish from the launcher statistics."
msgstr "Dies kann nicht rückgängig gemacht werden: Die Session kann nicht mehr fortgesetzt werden und ihre Kosten verschwinden aus der Launcher-Statistik."

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Cancel"
msgstr "Abbrechen"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Remove"
msgstr "Entfernen"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Could not delete: %s"
msgstr "Löschen fehlgeschlagen: %s"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Dashboard"
msgstr "Dashboard"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Refresh"
msgstr "Aktualisieren"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Settings"
msgstr "Einstellungen"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Generating…"
msgstr "Generiere…"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "No session selected"
msgstr "Keine Session ausgewählt"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "The session no longer exists"
msgstr "Die Session existiert nicht mehr"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Dashboard failed: %s"
msgstr "Dashboard fehlgeschlagen: %s"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "(empty)"
msgstr "(leer)"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "stale"
msgstr "veraltet"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Updated: %s"
msgstr "Stand: %s"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Dashboard settings"
msgstr "Dashboard-Einstellungen"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Status prompt"
msgstr "Status-Prompt"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Maximum cache age (minutes)"
msgstr "Maximales Cache-Alter (Minuten)"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Save"
msgstr "Speichern"

#: codewhale-launcher@luff.biz/prefs.js
msgid "A compact “current status” of a session’s workspace, generated with codewhale and cached to save tokens. Open it from the dashboard button next to each session."
msgstr "Ein kompakter „aktueller Status“ des Workspace einer Session – mit Codewhale erzeugt und gecacht, um Tokens zu sparen. Öffnen über die Dashboard-Schaltfläche neben jeder Session."

#: codewhale-launcher@luff.biz/prefs.js
msgid "Sent to `codewhale exec`. Kept generic — the workspace’s own instructions define what “status” means."
msgstr "Wird an `codewhale exec` gesendet. Bewusst generisch gehalten – die Anweisungen des jeweiligen Workspace definieren, was „Status“ bedeutet."

#: codewhale-launcher@luff.biz/prefs.js
msgid "Maximum cache age"
msgstr "Maximales Cache-Alter"

#: codewhale-launcher@luff.biz/prefs.js
msgid "Minutes before the status is regenerated even if the workspace has not changed."
msgstr "Minuten, bevor der Status neu erzeugt wird, auch wenn sich der Workspace nicht geändert hat."
