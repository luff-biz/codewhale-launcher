msgstr "कोई सत्र नहीं मिला"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Restore"
msgstr "पुनर्स्थापित करें"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Remove “%s”?"
msgstr "“%s” हटाएँ?"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "The session disappears from the launcher list but stays in the Codewhale store."
msgstr "सत्र लॉन्चर सूची से हट जाएगा, लेकिन Codewhale स्टोर में बना रहेगा।"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Also delete the session permanently from the Codewhale store"
msgstr "सत्र को Codewhale स्टोर से भी स्थायी रूप से हटाएँ"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "This cannot be undone: the session can no longer be resumed and its costs vanish from the launcher statistics."
msgstr "इसे पूर्ववत नहीं किया जा सकता: सत्र फिर से शुरू नहीं किया जा सकेगा और उसकी लागत लॉन्चर आँकड़ों से हट जाएगी।"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
msgid "Cancel"
msgstr "रद्द करें"

#: codewhale-launcher@luff.biz/extension.js codewhale-launcher@luff.biz/app/history.py
