#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Dashboard settings"
msgstr "Impostazioni del dashboard"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Status prompt"
msgstr "Prompt di stato"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Maximum cache age (minutes)"
msgstr "Età massima della cache (minuti)"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Save"
msgstr "Salva"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Maximum cache age"
msgstr "Età massima della cache"

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Minutes before the status is regenerated even if the workspace has not changed."
msgstr "Minuti prima che lo stato venga rigenerato anche se l'area di lavoro non è cambiata."

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "A compact “current status” of a session’s workspace, generated with codewhale and cached to save tokens. Open it from the dashboard button next to each session."
msgstr "Un «stato attuale» compatto dell'area di lavoro di una sessione, generato con codewhale e memorizzato nella cache per risparmiare token. Aprilo dal pulsante del dashboard accanto a ogni sessione."

#: codewhale-launcher@luff.biz/app/dashboard.py codewhale-launcher@luff.biz/prefs.js
msgid "Sent to `codewhale exec`. Kept generic — the workspace’s own instructions define what “status” means."
msgstr "Inviato a `codewhale exec`. Mantenuto generico: sono le istruzioni dell'area di lavoro a definire cosa significa «stato»."

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "About Codewhale Launcher"
msgstr "Informazioni su Codewhale Launcher"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Main Menu"
msgstr "Menu principale"

#: codewhale-launcher@luff.biz/app/dashboard.py
msgid "Start and resume Codewhale sessions straight from the top bar — one-click new sessions, recent sessions, balance and costs, and a per-session dashboard. No terminal required."
msgstr "Avvia e riprendi le sessioni di Codewhale direttamente dalla barra superiore: nuove sessioni con un clic, sessioni recenti, saldo e costi e un dashboard per sessione. Nessun terminale richiesto."

